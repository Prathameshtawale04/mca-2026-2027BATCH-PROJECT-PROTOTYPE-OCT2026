# ==============================================================================
# MovieFlix Environment Configuration
# Copy this file to .env and configure your secrets.
# Do NOT commit .env to version control!
# ==============================================================================

# TMDB Authentication
# Option A: TMDB API Read Access Token v4 (Recommended)
TMDB_ACCESS_TOKEN=

# Option B: TMDB API Key v3
TMDB_API_KEY=

# MySQL Database Configuration
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=movieflix

# Flask Application Settings
FLASK_SECRET_KEY=change-this-secret
FLASK_DEBUG=False
FLASK_PORT=5000
